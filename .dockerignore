# .dockerignore - Prevent unnecessary files from slowing build
# Goal: Keep build context small (checkpoint is ~200MB, so expect ~<250MB total).

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/
.uv_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
backups/
reference_repos/
wandb/

# Data (mount as volume instead - 449GB!)
cache/
data_ext4/
results/
!results/local_fla_exp4_cyclic/
results/local_fla_exp4_cyclic/*
!results/local_fla_exp4_cyclic/checkpoints/
results/local_fla_exp4_cyclic/checkpoints/*
!results/local_fla_exp4_cyclic/checkpoints/best.pt

# Git
.git/
.gitignore

# Docs (exclude most, keep critical ones)
docs/
*.md
!README.md
!DOCKER_IMPLEMENTATION_PLAN.md
!CLAUDE.md
!INSTALLATION.md
!CHANGELOG.md

# Tests
tests/

# Secrets
.env
*.key
*.pem
